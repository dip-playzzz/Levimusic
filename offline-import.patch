-bool takeResults(OnlineEntry* out, int capacity, int* count) {
-    bool ready = false;
-    lockState();
-    if (g.resultsReady) {
-        const int n = g.resultCount < capacity ? g.resultCount : capacity;
-        for (int i = 0; i < n; ++i) out[i] = g.results[i];
-        if (count) *count = n;
-        g.resultsReady = false;
-        ready = true;
-    }
-    unlockState();
-    return ready;
-}
