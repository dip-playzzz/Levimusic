+// Counts audio formats and how many carry a plain url vs a signature cipher.
+void summarizeFormats(const char* body, const char* end, int& audio, int& plain, int& cipher) {
+    audio = plain = cipher = 0;
+    const char* list = json::findKey(body, end, "adaptiveFormats");
+    if (!list || *list != '[') return;
+    const char* listEnd = json::skipValue(list, end);
+    const char* p = json::skipSpace(list + 1, listEnd);
+    while (p < listEnd && *p != ']') {
+        if (*p != '{') { ++p; continue; }
+        const char* objectEnd = json::skipValue(p, listEnd);
+        char mime[48]{};
+        const char* mimeValue = json::findKey(p, objectEnd, "mimeType");
+        if (mimeValue && json::readString(mimeValue, objectEnd, mime, sizeof(mime)) &&
+            startsWith(mime, "audio/")) {
+            ++audio;
+            if (json::findKey(p, objectEnd, "url")) ++plain;
+            else if (json::findKey(p, objectEnd, "signatureCipher") ||
+                     json::findKey(p, objectEnd, "cipher")) ++cipher;
+        }
+        p = objectEnd;
+    }
+}
