+// Tries the remembered web version first, then the others.
+int webSearch(const char* query, char* buffer, int capacity) {
+    int status = -1;
+    for (int i = 0; i < WebClientVersionCount && !g.quit; ++i) {
+        const int index = (g.webVersion + i) % WebClientVersionCount;
+        status = webSearchOnce(query, WebClientVersions[index], buffer, capacity);
+        if (status == 200) { g.webVersion = index; return status; }
+        if (status < 0) break;   // no network: other versions will not help
+    }
+    return status;
+}
