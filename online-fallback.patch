+// Asks one client profile for a stream. Returns true and fills `stream` on success;
+// otherwise writes a short reason (without the client prefix) to `reason`.
+bool tryClient(const ClientProfile& client, const char* id, char* buffer, int capacity,
+               Stream& stream, char* reason, usize reasonCap) {
+    char visitorField[320]{};
+    if (g.visitor[0]) snprintf(visitorField, sizeof(visitorField), ",\"visitorData\":\"%s\"", g.visitor);
+    char body[1536];
+    snprintf(body, sizeof(body),
+             "{\"context\":{\"client\":{\"clientName\":\"%s\",\"clientVersion\":\"%s\",%s"
+             "\"hl\":\"en\",\"gl\":\"US\"%s}},"
+             "\"videoId\":\"%s\",\"contentCheckOk\":true,\"racyCheckOk\":true}",
+             client.clientName, client.clientVersion, client.contextExtra, visitorField, id);
+
+    http::Header headers[6];
+    int count = 0;
+    headers[count++] = {"Content-Type", "application/json"};
+    headers[count++] = {"User-Agent", client.userAgent};
+    headers[count++] = {"X-YouTube-Client-Name", client.clientId};
+    headers[count++] = {"X-YouTube-Client-Version", client.clientVersion};
+    if (g.visitor[0]) headers[count++] = {"X-Goog-Visitor-Id", g.visitor};
+    if (client.sendOrigin) headers[count++] = {"Origin", "https://www.youtube.com"};
+
+    const long started = nowMs();
+    const http::Result result = http::request(jni::javaVm(), "POST", PlayerUrl,
+                                              headers, count, body, -1, buffer, capacity, &g.quit);
+    levi_log(LOG_INFO_VALUE, LogTag, "player[%s] http status=%d bytes=%lld in %ld ms",
+             client.shortName, result.status, result.received, nowMs() - started);
+    if (result.status != 200) {
+        snprintf(reason, reasonCap, result.status < 0 ? "no network" : "HTTP %d", result.status);
+        return false;
+    }
+    const char* end = buffer + strlen(buffer);
+    captureVisitor(buffer, end);
+    char state[48]{};
+    char why[96]{};
+    if (const char* playability = json::findKey(buffer, end, "playabilityStatus")) {
+        const char* pEnd = json::skipValue(playability, end);
+        json::readString(json::findKey(playability, pEnd, "status"), pEnd, state, sizeof(state));
+        json::readString(json::findKey(playability, pEnd, "reason"), pEnd, why, sizeof(why));
+    }
+    if (strcmp(state, "OK") != 0) {
+        copyString(reason, reasonCap, state[0] ? state : "unplayable");
+        levi_log(LOG_ERROR_VALUE, LogTag, "player[%s] %s: %s %s", client.shortName, id, state, why);
+        return false;
+    }
+    int audio = 0, plain = 0, cipher = 0;
+    summarizeFormats(buffer, end, audio, plain, cipher);
+    levi_log(LOG_INFO_VALUE, LogTag, "player[%s] %s: audio formats=%d plain-url=%d cipher=%d",
+             client.shortName, id, audio, plain, cipher);
+    if (chooseFormat(buffer, end, stream)) {
+        stream.userAgent = client.userAgent;
+        return true;
+    }
+    copyString(reason, reasonCap, cipher > 0 ? "needs signature" : "no audio url");
+    return false;
+}
